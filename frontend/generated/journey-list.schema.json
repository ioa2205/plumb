{
  "$defs": {
    "AccountRecord": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 600,
          "title": "Note",
          "type": "string"
        },
        "session_kept": {
          "default": false,
          "title": "Session Kept",
          "type": "boolean"
        },
        "state": {
          "default": "not_tried",
          "enum": [
            "not_tried",
            "signed_in",
            "created",
            "failed",
            "handoff",
            "uncertain",
            "needs_sign_in"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "account_id"
      ],
      "title": "AccountRecord",
      "type": "object"
    },
    "BlockedRequest": {
      "additionalProperties": false,
      "description": "Something the page wanted that was not allowed. Shown, never silently dropped.",
      "properties": {
        "count": {
          "default": 1,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "host": {
          "maxLength": 253,
          "title": "Host",
          "type": "string"
        },
        "kind": {
          "enum": [
            "off_scope",
            "redirect",
            "websocket",
            "download",
            "budget",
            "address",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "host",
        "reason"
      ],
      "title": "BlockedRequest",
      "type": "object"
    },
    "CheckRecord": {
      "additionalProperties": false,
      "description": "One cross-account comparison on a known synthetic object, as code computed it.",
      "properties": {
        "check_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Check Id",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 20,
          "title": "Citations",
          "type": "array"
        },
        "comparison": {
          "default": "not_run",
          "enum": [
            "candidate",
            "protected",
            "inconclusive",
            "not_run"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "facts": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 24,
          "title": "Facts",
          "type": "object"
        },
        "gaps": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Gaps",
          "type": "array"
        },
        "judged": {
          "anyOf": [
            {
              "enum": [
                "supported",
                "not_confirmed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judged"
        },
        "judgment": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judgment"
        },
        "note": {
          "default": "",
          "maxLength": 600,
          "title": "Note",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "other_account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Other Account Id",
          "type": "string"
        },
        "owner_account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Owner Account Id",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "title": "Path",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Rule Id",
          "type": "string"
        },
        "state": {
          "default": "pending",
          "enum": [
            "pending",
            "completed",
            "blocked"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "rule_id",
        "object_id",
        "path",
        "owner_account_id",
        "other_account_id"
      ],
      "title": "CheckRecord",
      "type": "object"
    },
    "DecisionRecord": {
      "additionalProperties": false,
      "description": "One decision and the rung of the ladder that made it. Raw answers are kept.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "attempts": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "maxItems": 6,
          "title": "Attempts",
          "type": "array"
        },
        "question_type": {
          "maxLength": 40,
          "title": "Question Type",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "rung": {
          "enum": [
            "code",
            "model",
            "model_reordered",
            "user",
            "stop"
          ],
          "title": "Rung",
          "type": "string"
        },
        "stage": {
          "enum": [
            "scope",
            "discover",
            "authenticate",
            "map",
            "select",
            "execute",
            "challenge",
            "record",
            "report"
          ],
          "title": "Stage",
          "type": "string"
        },
        "subject": {
          "maxLength": 200,
          "title": "Subject",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "at",
        "stage",
        "question_type",
        "subject",
        "rung"
      ],
      "title": "DecisionRecord",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "field": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "field",
        "sha256"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "affected_application": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Affected Application",
          "type": "string"
        },
        "affected_endpoint": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Affected Endpoint",
          "type": "string"
        },
        "check_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Check Id",
          "type": "string"
        },
        "conclusion": {
          "enum": [
            "supported",
            "candidate"
          ],
          "title": "Conclusion",
          "type": "string"
        },
        "description": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "explanation": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "explanation_source": {
          "enum": [
            "model",
            "code"
          ],
          "title": "Explanation Source",
          "type": "string"
        },
        "finding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Finding Id",
          "type": "string"
        },
        "limits": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Limits",
          "type": "array"
        },
        "methodology": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Methodology",
          "type": "array"
        },
        "mitigation": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Mitigation",
          "type": "string"
        },
        "potential_impact": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Potential Impact",
          "type": "string"
        },
        "runtime": {
          "const": "observed_once_by_plumb_runner",
          "default": "observed_once_by_plumb_runner",
          "title": "Runtime",
          "type": "string"
        },
        "safe_reproduction": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Safe Reproduction",
          "type": "array"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "tools_and_models": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Tools And Models",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "title",
        "conclusion",
        "description",
        "affected_application",
        "affected_endpoint",
        "safe_reproduction",
        "potential_impact",
        "evidence",
        "mitigation",
        "methodology",
        "tools_and_models",
        "limits",
        "explanation",
        "explanation_source",
        "check_id"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Incident": {
      "additionalProperties": false,
      "description": "A privacy or production-risk stop. Kinds only; the content was discarded.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "content_kept": {
          "const": false,
          "default": false,
          "title": "Content Kept",
          "type": "boolean"
        },
        "kinds": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Kinds",
          "type": "array"
        },
        "path": {
          "maxLength": 512,
          "title": "Path",
          "type": "string"
        },
        "step_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "at",
        "step_id",
        "path",
        "kinds"
      ],
      "title": "Incident",
      "type": "object"
    },
    "JourneyView": {
      "additionalProperties": false,
      "properties": {
        "accounts": {
          "items": {
            "$ref": "#/$defs/AccountRecord"
          },
          "maxItems": 6,
          "title": "Accounts",
          "type": "array"
        },
        "activity": {
          "default": "Waiting for the plan to be approved.",
          "maxLength": 300,
          "title": "Activity",
          "type": "string"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanApproval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approval_revoked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Revoked At"
        },
        "approval_used_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Used At"
        },
        "blocked": {
          "items": {
            "$ref": "#/$defs/BlockedRequest"
          },
          "maxItems": 200,
          "title": "Blocked",
          "type": "array"
        },
        "browser": {
          "default": "not_used",
          "enum": [
            "not_used",
            "used",
            "unavailable"
          ],
          "title": "Browser",
          "type": "string"
        },
        "browser_note": {
          "default": "",
          "maxLength": 600,
          "title": "Browser Note",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckRecord"
          },
          "maxItems": 40,
          "title": "Checks",
          "type": "array"
        },
        "confidentiality": {
          "const": "private_local",
          "default": "private_local",
          "title": "Confidentiality",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/DecisionRecord"
          },
          "maxItems": 200,
          "title": "Decisions",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/WebEvidence"
          },
          "maxItems": 300,
          "title": "Evidence",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "maxItems": 40,
          "title": "Findings",
          "type": "array"
        },
        "handoffs": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Handoffs",
          "type": "array"
        },
        "incidents": {
          "items": {
            "$ref": "#/$defs/Incident"
          },
          "maxItems": 20,
          "title": "Incidents",
          "type": "array"
        },
        "journey_id": {
          "pattern": "^journey-[0-9a-f]{32}$",
          "title": "Journey Id",
          "type": "string"
        },
        "leads": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Leads",
          "type": "array"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/PageRecord"
          },
          "maxItems": 120,
          "title": "Pages",
          "type": "array"
        },
        "plan": {
          "$ref": "#/$defs/WebsitePlan"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "report_path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Path"
        },
        "scope": {
          "$ref": "#/$defs/WebsiteScope"
        },
        "spent": {
          "$ref": "#/$defs/Spent"
        },
        "stage": {
          "default": "scope",
          "enum": [
            "scope",
            "discover",
            "authenticate",
            "map",
            "select",
            "execute",
            "challenge",
            "record",
            "report"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "default": "planned",
          "enum": [
            "planned",
            "approved",
            "running",
            "paused",
            "stopped",
            "handoff",
            "done",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/StepRecord"
          },
          "maxItems": 60,
          "title": "Steps",
          "type": "array"
        },
        "stop_reason": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "waiting": {
          "items": {
            "$ref": "#/$defs/UserQuestion"
          },
          "maxItems": 20,
          "title": "Waiting",
          "type": "array"
        }
      },
      "required": [
        "journey_id",
        "scope",
        "plan",
        "plan_sha256",
        "created_at",
        "updated_at"
      ],
      "title": "JourneyView",
      "type": "object"
    },
    "JsonValue": {},
    "LoginConfig": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "success_path": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Success Path"
        },
        "success_text": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Success Text"
        }
      },
      "required": [
        "path"
      ],
      "title": "LoginConfig",
      "type": "object"
    },
    "OwnerRule": {
      "additionalProperties": false,
      "description": "What the owner says should happen. A declaration, never an observation.",
      "properties": {
        "allowed_account_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Allowed Account Ids",
          "type": "array"
        },
        "basis": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "declared_by": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Declared By",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Rule Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "statement",
        "object_id",
        "allowed_account_ids",
        "declared_by",
        "basis"
      ],
      "title": "OwnerRule",
      "type": "object"
    },
    "PageRecord": {
      "additionalProperties": false,
      "description": "One place in the page and action map.",
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "blocked": {
          "items": {
            "$ref": "#/$defs/BlockedRequest"
          },
          "maxItems": 40,
          "title": "Blocked",
          "type": "array"
        },
        "evidence_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "forms": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Forms",
          "type": "array"
        },
        "kind": {
          "default": "",
          "maxLength": 40,
          "title": "Kind",
          "type": "string"
        },
        "kind_rung": {
          "anyOf": [
            {
              "enum": [
                "code",
                "model",
                "model_reordered",
                "user",
                "stop"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind Rung"
        },
        "links": {
          "default": 0,
          "minimum": 0,
          "title": "Links",
          "type": "integer"
        },
        "note": {
          "default": "",
          "maxLength": 300,
          "title": "Note",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "title": "Path",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "title": {
          "default": "",
          "maxLength": 160,
          "title": "Title",
          "type": "string"
        },
        "via": {
          "enum": [
            "http",
            "browser"
          ],
          "title": "Via",
          "type": "string"
        }
      },
      "required": [
        "path",
        "via"
      ],
      "title": "PageRecord",
      "type": "object"
    },
    "PlanApproval": {
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
