{
  "$defs": {
    "ConversationEvidence": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "model_quote": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Quote"
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceCitation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quote": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "reference_id": {
          "pattern": "^R[0-9]{3}$",
          "title": "Reference Id",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "reference_id",
        "label",
        "quote"
      ],
      "title": "ConversationEvidence",
      "type": "object"
    },
    "ConversationTurn": {
      "additionalProperties": false,
      "properties": {
        "actions_executed": {
          "const": false,
          "default": false,
          "title": "Actions Executed",
          "type": "boolean"
        },
        "answer": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "authorization_granted": {
          "const": false,
          "default": false,
          "title": "Authorization Granted",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ConversationEvidence"
          },
          "maxItems": 8,
          "title": "Evidence",
          "type": "array"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "generated_by": {
          "enum": [
            "local_model",
            "unresolved"
          ],
          "title": "Generated By",
          "type": "string"
        },
        "prompt": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Unknowns",
          "type": "array"
        },
        "verdict_changed": {
          "const": false,
          "default": false,
          "title": "Verdict Changed",
          "type": "boolean"
        }
      },
      "required": [
        "prompt",
        "answer",
        "evidence",
        "unknowns",
        "generated_by",
        "evidence_sha256"
      ],
      "title": "ConversationTurn",
      "type": "object"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "field": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "field",
        "sha256"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "A citation: lines in one file of one snapshot, with the hash of their text.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "path",
        "start_line",
        "end_line",
        "content_sha256"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "$id": "https://plumb.local/schemas/ConversationView.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidentiality": {
      "const": "private_local",
      "default": "private_local",
      "title": "Confidentiality",
      "type": "string"
    },
    "conversation_id": {
      "pattern": "^conversation-[0-9a-f]{32}$",
      "title": "Conversation Id",
      "type": "string"
    },
    "message": {
      "default": "Ready for a local evidence question.",
      "maxLength": 512,
      "title": "Message",
      "type": "string"
    },
    "state": {
      "default": "idle",
      "enum": [
        "idle",
        "running",
        "completed",
        "failed",
        "canceled"
      ],
      "title": "State",
      "type": "string"
    },
    "target_id": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "target_kind": {
      "enum": [
        "inspection",
        "review",
        "assessment"
      ],
      "title": "Target Kind",
      "type": "string"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/ConversationTurn"
      },
      "maxItems": 20,
      "title": "Turns",
      "type": "array"
    }
  },
  "required": [
    "target_kind",
    "target_id",
    "conversation_id"
  ],
  "title": "ConversationView",
  "type": "object"
}
