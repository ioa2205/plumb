{
  "$defs": {
    "Access": {
      "enum": [
        "allowed",
        "denied"
      ],
      "title": "Access",
      "type": "string"
    },
    "AccessSite": {
      "additionalProperties": false,
      "description": "A place where a resource is loaded by a request-controlled identifier.",
      "properties": {
        "data_layer": {
          "$ref": "#/$defs/DataLayer"
        },
        "entry_point_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Entry Point Id",
          "type": "string"
        },
        "guard_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Guard Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "key_origin": {
          "$ref": "#/$defs/InputOrigin"
        },
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "id",
        "snapshot_id",
        "entry_point_id",
        "resource",
        "operation",
        "key_origin",
        "data_layer",
        "span"
      ],
      "title": "AccessSite",
      "type": "object"
    },
    "BoundPolicy": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "$ref": "#/$defs/PolicyAssertion"
        },
        "forbidden_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Forbidden Fields",
          "type": "array"
        },
        "provenance": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "required_role": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Role"
        },
        "sites": {
          "items": {
            "$ref": "#/$defs/AccessSite"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Sites",
          "type": "array"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Run Id",
          "type": "string"
        }
      },
      "required": [
        "assertion",
        "snapshot_id",
        "source_run_id",
        "sites",
        "provenance"
      ],
      "title": "BoundPolicy",
      "type": "object"
    },
    "ChallengeCheck": {
      "additionalProperties": false,
      "description": "One acquittal checklist item and what the search found (negative evidence).",
      "properties": {
        "exhibit_tag": {
          "anyOf": [
            {
              "pattern": "^E\\d{2,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exhibit Tag"
        },
        "found": {
          "title": "Found",
          "type": "boolean"
        },
        "item": {
          "title": "Item",
          "type": "string"
        },
        "searched": {
          "title": "Searched",
          "type": "string"
        }
      },
      "required": [
        "item",
        "searched",
        "found"
      ],
      "title": "ChallengeCheck",
      "type": "object"
    },
    "ChangeStatus": {
      "enum": [
        "proposed",
        "replayed_fixed",
        "replayed_not_fixed",
        "replay_failed"
      ],
      "title": "ChangeStatus",
      "type": "string"
    },
    "Conclusion": {
      "enum": [
        "candidate",
        "supported",
        "rejected",
        "inconclusive"
      ],
      "title": "Conclusion",
      "type": "string"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "setup_required",
        "model_too_large",
        "runner_unavailable",
        "stale_source",
        "unsupported_framework",
        "unreadable_file",
        "partial_coverage"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "True-denominator progress: every question is counted somewhere.",
      "properties": {
        "completed": {
          "default": 0,
          "minimum": 0,
          "title": "Completed",
          "type": "integer"
        },
        "excluded": {
          "default": 0,
          "minimum": 0,
          "title": "Excluded",
          "type": "integer"
        },
        "pending": {
          "default": 0,
          "minimum": 0,
          "title": "Pending",
          "type": "integer"
        },
        "total": {
          "default": 0,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "unsupported": {
          "default": 0,
          "minimum": 0,
          "title": "Unsupported",
          "type": "integer"
        }
      },
      "title": "Coverage",
      "type": "object"
    },
    "DataLayer": {
      "enum": [
        "sqlalchemy",
        "raw_sql",
        "prisma",
        "drizzle",
        "other"
      ],
      "title": "DataLayer",
      "type": "string"
    },
    "Disposition": {
      "enum": [
        "open",
        "dismissed",
        "accepted_risk",
        "resolved"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "DispositionDecision": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "expected_version": {
          "maximum": 100,
          "minimum": 0,
          "title": "Expected Version",
          "type": "integer"
        },
        "finding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Finding Id",
          "type": "string"
        },
        "original_finding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Finding Sha256",
          "type": "string"
        },
        "previous_disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "resolution_commit": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 40,
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Commit"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "version": {
          "maximum": 100,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "expected_version",
        "previous_disposition",
        "disposition",
        "reason",
        "actor",
        "run_id",
        "finding_id",
        "original_finding_sha256",
        "version",
        "recorded_at"
      ],
      "title": "DispositionDecision",
      "type": "object"
    },
    "EntryPoint": {
      "additionalProperties": false,
      "properties": {
        "framework": {
          "$ref": "#/$defs/Framework"
        },
        "handler_symbol_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Handler Symbol Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EntryPointKind"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "id",
        "snapshot_id",
        "kind",
        "framework",
        "handler_symbol_id",
        "span"
      ],
      "title": "EntryPoint",
      "type": "object"
    },
    "EntryPointKind": {
      "enum": [
        "http_route",
        "route_handler",
        "server_action",
        "page"
      ],
      "title": "EntryPointKind",
      "type": "string"
    },
    "EvidenceStrength": {
      "enum": [
        "complete",
        "partial",
        "thin"
      ],
      "title": "EvidenceStrength",
      "type": "string"
    },
    "Exhibit": {
      "additionalProperties": false,
      "properties": {
        "gloss": {
          "title": "Gloss",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ExhibitRole"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "tag": {
          "pattern": "^E\\d{2,3}$",
          "title": "Tag",
          "type": "string"
        }
      },
      "required": [
        "tag",
        "span",
        "role",
        "gloss"
      ],
      "title": "Exhibit",
      "type": "object"
    },
    "ExhibitRole": {
      "enum": [
        "evidence",
        "source",
        "sink",
        "guard",
        "deviant",
        "developer_note"
      ],
      "title": "ExhibitRole",
      "type": "string"
    },
    "Family": {
      "description": "Vulnerability families investigated in depth (PROJECT_PLAN \u00a74).",
      "enum": [
        "authorization",
        "injection",
        "path_traversal",
        "nextjs_exposure"
      ],
      "title": "Family",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "A case file. The five evidence-contract fields are independent (PROJECT_PLAN \u00a76).",
      "properties": {
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ChallengeCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "conclusion": {
          "$ref": "#/$defs/Conclusion"
        },
        "cwe": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Cwe",
          "type": "array"
        },
        "display_id": {
          "pattern": "^F-\\d{2,}$",
          "title": "Display Id",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/Disposition",
          "default": "open"
        },
        "disposition_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disposition Reason"
        },
        "exhibits": {
          "items": {
            "$ref": "#/$defs/Exhibit"
          },
          "title": "Exhibits",
          "type": "array"
        },
        "family": {
          "$ref": "#/$defs/Family"
        },
        "flow": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowStep"
          },
          "title": "Flow",
          "type": "array"
        },
        "gaps": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "lede": {
          "title": "Lede",
          "type": "string"
        },
        "peer_group_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peer Group Id"
        },
        "policy_basis": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BoundPolicy"
          },
          "maxItems": 100,
          "title": "Policy Basis",
          "type": "array"
        },
        "probe_run_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Probe Run Ids",
          "type": "array"
        },
        "question_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Question Ids",
          "type": "array"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "runtime_verification": {
          "$ref": "#/$defs/RuntimeVerification",
          "default": "not_attempted"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "severity_rationale": {
          "minLength": 1,
          "title": "Severity Rationale",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "strength": {
          "$ref": "#/$defs/EvidenceStrength"
        },
        "suggested_change_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Change Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "id",
        "display_id",
        "run_id",
        "snapshot_id",
        "family",
        "cwe",
        "title",
        "lede",
        "conclusion",
        "severity",
        "severity_rationale",
        "strength",
        "exhibits"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FixProposal": {
      "additionalProperties": false,
      "properties": {
        "adapter_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Manifest Sha256"
        },
        "change": {
          "anyOf": [
            {
              "$ref": "#/$defs/SuggestedChange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Finding Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "probe_reason": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Probe Reason",
          "type": "string"
        },
        "probe_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProbeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "probe_status": {
          "default": "unavailable",
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Probe Status",
          "type": "string"
        },
        "reason": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "refused",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "finding_id",
        "snapshot_id",
        "status",
        "reason",
        "probe_reason"
      ],
      "title": "FixProposal",
      "type": "object"
    },
    "FlowStep": {
      "additionalProperties": false,
      "properties": {
        "exhibit_tag": {
          "pattern": "^E\\d{2,3}$",
          "title": "Exhibit Tag",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "exhibit_tag"
      ],
      "title": "FlowStep",
      "type": "object"
    },
    "Framework": {
      "enum": [
        "fastapi",
        "nextjs"
      ],
      "title": "Framework",
      "type": "string"
    },
    "Guard": {
      "additionalProperties": false,
      "description": "A check on the path to an access site, normalized to a canonical form.\n\n``confirmed`` means the validator found executable code at ``span`` that\nperforms the check. A name or a comment never confirms a guard.",
      "properties": {
        "canonical": {
          "title": "Canonical",
          "type": "string"
        },
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GuardKind"
        },
        "mechanism": {
          "$ref": "#/$defs/GuardMechanism"
        },
        "object": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "via_symbol_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via Symbol Id"
        }
      },
      "required": [
        "id",
        "snapshot_id",
        "kind",
        "canonical",
        "mechanism",
        "span"
      ],
      "title": "Guard",
      "type": "object"
    },
    "GuardKind": {
      "description": "Canonical guard kinds from the ``guard_summary`` question (PROJECT_PLAN \u00a73.1).",
      "enum": [
        "authenticated",
        "owner",
        "tenant",
        "role",
        "none",
        "unknown",
        "parameterized",
        "allowlisted",
        "contained",
        "minimized"
      ],
      "title": "GuardKind",
      "type": "string"
    },
    "GuardMechanism": {
      "enum": [
        "dependency",
        "decorator",
        "query_filter",
        "comparison",
        "helper_call",
        "data_access_layer",
        "router",
        "proxy_matcher"
      ],
      "title": "GuardMechanism",
      "type": "string"
    },
    "HTTPProbeRequest": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "capture": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 3,
          "title": "Capture",
          "type": "object"
        },
        "expected_if_safe": {
          "$ref": "#/$defs/Access"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "principal": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Principal",
          "type": "string"
        },
