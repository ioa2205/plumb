{
  "$defs": {
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "setup_required",
        "model_too_large",
        "runner_unavailable",
        "stale_source",
        "unsupported_framework",
        "unreadable_file",
        "partial_coverage"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "True-denominator progress: every question is counted somewhere.",
      "properties": {
        "completed": {
          "default": 0,
          "minimum": 0,
          "title": "Completed",
          "type": "integer"
        },
        "excluded": {
          "default": 0,
          "minimum": 0,
          "title": "Excluded",
          "type": "integer"
        },
        "pending": {
          "default": 0,
          "minimum": 0,
          "title": "Pending",
          "type": "integer"
        },
        "total": {
          "default": 0,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "unsupported": {
          "default": 0,
          "minimum": 0,
          "title": "Unsupported",
          "type": "integer"
        }
      },
      "title": "Coverage",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "quantization": {
          "title": "Quantization",
          "type": "string"
        }
      },
      "required": [
        "id",
        "file_sha256",
        "quantization"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "RunLifecycle": {
      "enum": [
        "queued",
        "running",
        "paused",
        "canceled",
        "failed",
        "completed"
      ],
      "title": "RunLifecycle",
      "type": "string"
    },
    "RunStage": {
      "enum": [
        "indexing",
        "scanning",
        "investigating",
        "verifying",
        "reporting"
      ],
      "title": "RunStage",
      "type": "string"
    },
    "RunType": {
      "description": "Live, replayed, and saved runs are always labeled differently (PROJECT_PLAN \u00a715).",
      "enum": [
        "live",
        "replay",
        "saved"
      ],
      "title": "RunType",
      "type": "string"
    },
    "Toolchain": {
      "additionalProperties": false,
      "description": "Everything needed to reproduce a run (design.md \u00a712, Runs).",
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "knowledge_pack_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Pack Date"
        },
        "llama_cpp_build": {
          "title": "Llama Cpp Build",
          "type": "string"
        },
        "llama_cpp_release": {
          "title": "Llama Cpp Release",
          "type": "string"
        },
        "opengrep_rules_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opengrep Rules Sha256"
        },
        "opengrep_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opengrep Version"
        }
      },
      "required": [
        "llama_cpp_release",
        "llama_cpp_build",
        "backend"
      ],
      "title": "Toolchain",
      "type": "object"
    }
  },
  "$id": "https://plumb.local/schemas/ReviewRun.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conditions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Condition"
      },
      "title": "Conditions",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage",
      "default": {
        "completed": 0,
        "excluded": 0,
        "pending": 0,
        "total": 0,
        "unsupported": 0
      }
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "finding_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "lifecycle": {
      "$ref": "#/$defs/RunLifecycle"
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_type": {
      "$ref": "#/$defs/RunType"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "stage": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "toolchain": {
      "anyOf": [
        {
          "$ref": "#/$defs/Toolchain"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "snapshot_id",
    "run_type",
    "lifecycle",
    "created_at"
  ],
  "title": "ReviewRun",
  "type": "object"
}
