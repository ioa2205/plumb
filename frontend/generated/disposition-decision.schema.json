{
  "$defs": {
    "Disposition": {
      "enum": [
        "open",
        "dismissed",
        "accepted_risk",
        "resolved"
      ],
      "title": "Disposition",
      "type": "string"
    }
  },
  "$id": "https://plumb.local/schemas/DispositionDecision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "disposition": {
      "$ref": "#/$defs/Disposition"
    },
    "expected_version": {
      "maximum": 100,
      "minimum": 0,
      "title": "Expected Version",
      "type": "integer"
    },
    "finding_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Finding Id",
      "type": "string"
    },
    "original_finding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Original Finding Sha256",
      "type": "string"
    },
    "previous_disposition": {
      "$ref": "#/$defs/Disposition"
    },
    "reason": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "resolution_commit": {
      "anyOf": [
        {
          "maxLength": 40,
          "minLength": 40,
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution Commit"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "version": {
      "maximum": 100,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "snapshot_id",
    "expected_version",
    "previous_disposition",
    "disposition",
    "reason",
    "actor",
    "run_id",
    "finding_id",
    "original_finding_sha256",
    "version",
    "recorded_at"
  ],
  "title": "DispositionDecision",
  "type": "object"
}
