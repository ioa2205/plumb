{
  "$defs": {
    "AccessExpectation": {
      "additionalProperties": false,
      "properties": {
        "allowed_account_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Allowed Account Ids",
          "type": "array"
        },
        "basis": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "declared_by": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Declared By",
          "type": "string"
        },
        "expectation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Expectation Id",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "statement": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "expectation_id",
        "path",
        "object_id",
        "allowed_account_ids",
        "statement",
        "declared_by",
        "basis"
      ],
      "title": "AccessExpectation",
      "type": "object"
    },
    "AssessmentAnswer": {
      "additionalProperties": false,
      "properties": {
        "answer_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Answer Id",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/EvidenceCitation"
          },
          "maxItems": 100,
          "title": "Citations",
          "type": "array"
        },
        "generated_by": {
          "default": "deterministic",
          "enum": [
            "deterministic",
            "local_model"
          ],
          "title": "Generated By",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/AssessmentTask"
        },
        "text": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "answer_id",
        "task",
        "text"
      ],
      "title": "AssessmentAnswer",
      "type": "object"
    },
    "AssessmentBudget": {
      "additionalProperties": false,
      "properties": {
        "max_requests": {
          "default": 3,
          "maximum": 30,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_seconds": {
          "default": 180,
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Seconds",
          "type": "integer"
        }
      },
      "title": "AssessmentBudget",
      "type": "object"
    },
    "AssessmentScope": {
      "additionalProperties": false,
      "properties": {
        "accounts": {
          "items": {
            "$ref": "#/$defs/TestAccount"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Accounts",
          "type": "array"
        },
        "allowed_actions": {
          "items": {
            "enum": [
              "read",
              "compare",
              "plan",
              "report",
              "analyze",
              "collect",
              "authenticate",
              "create_synthetic"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Allowed Actions",
          "type": "array"
        },
        "allowed_paths": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Allowed Paths",
          "type": "array"
        },
        "application_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Application Id",
          "type": "string"
        },
        "application_name": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Application Name",
          "type": "string"
        },
        "assessment_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
          "title": "Assessment Id",
          "type": "string"
        },
        "authority": {
          "$ref": "#/$defs/ScopeAuthority"
        },
        "budget": {
          "$ref": "#/$defs/AssessmentBudget"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "external_access_enabled": {
          "const": false,
          "default": false,
          "title": "External Access Enabled",
          "type": "boolean"
        },
        "origin": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
          "title": "Scope Id",
          "type": "string"
        },
        "stop_conditions": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Stop Conditions",
          "type": "array"
        },
        "synthetic_objects": {
          "items": {
            "$ref": "#/$defs/SyntheticObject"
          },
          "maxItems": 100,
          "title": "Synthetic Objects",
          "type": "array"
        }
      },
      "required": [
        "scope_id",
        "assessment_id",
        "application_id",
        "application_name",
        "origin",
        "allowed_paths",
        "allowed_actions",
        "accounts",
        "authority",
        "expires_at",
        "stop_conditions"
      ],
      "title": "AssessmentScope",
      "type": "object"
    },
    "AssessmentTask": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "compare",
            "explain",
            "missing",
            "plan",
            "report",
            "analyze",
            "source_review"
          ],
          "title": "Action",
          "type": "string"
        },
        "authorization_granted": {
          "const": false,
          "default": false,
          "title": "Authorization Granted",
          "type": "boolean"
        },
        "budget": {
          "$ref": "#/$defs/AssessmentBudget"
        },
        "clarification": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarification"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 3,
          "title": "Evidence Ids",
          "type": "array"
        },
        "focus": {
          "default": "",
          "maxLength": 256,
          "title": "Focus",
          "type": "string"
        },
        "network_activity": {
          "const": false,
          "default": false,
          "title": "Network Activity",
          "type": "boolean"
        },
        "prompt": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "status": {
          "default": "resolved",
          "enum": [
            "resolved",
            "clarification_required",
            "refused"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "target_id",
        "action",
        "prompt"
      ],
      "title": "AssessmentTask",
      "type": "object"
    },
    "AttachmentReview": {
      "additionalProperties": false,
      "properties": {
        "confirmed_sanitized": {
          "const": true,
          "title": "Confirmed Sanitized",
          "type": "boolean"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewed_by": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reviewed By",
          "type": "string"
        }
      },
      "required": [
        "reviewed_by",
        "confirmed_sanitized",
        "reviewed_at"
      ],
      "title": "AttachmentReview",
      "type": "object"
    },
    "ComparisonRequest": {
      "additionalProperties": false,
      "properties": {
        "control_artifact_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Artifact Id"
        },
        "expectation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expectation Id"
        },
        "left_artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Left Artifact Id",
          "type": "string"
        },
        "right_artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Right Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "left_artifact_id",
        "right_artifact_id"
      ],
      "title": "ComparisonRequest",
      "type": "object"
    },
    "EvidenceArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "assessment_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Assessment Id",
          "type": "string"
        },
        "attachment_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attachment Path"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_status": {
          "const": "imported",
          "default": "imported",
          "title": "Execution Status",
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 200,
          "minProperties": 1,
          "title": "Fields",
          "type": "object"
        },
        "imported_at": {
          "format": "date-time",
          "title": "Imported At",
          "type": "string"
        },
        "kind": {
          "enum": [
            "request_response",
            "note",
            "screenshot"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/AttachmentReview"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "trusted_lab_collection": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabCollectionBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "artifact_id",
        "assessment_id",
        "kind",
        "sha256",
        "collected_at",
        "imported_at",
        "provenance",
        "review",
        "fields"
      ],
      "title": "EvidenceArtifact",
      "type": "object"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "field": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "field",
        "sha256"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "JsonValue": {},
    "LabCollectionBinding": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "preview_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preview Sha256",
          "type": "string"
        },
        "runner_origin": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Runner Origin",
          "type": "string"
        },
        "scope_origin": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Scope Origin",
          "type": "string"
        }
      },
      "required": [
        "manifest_sha256",
        "scope_origin",
        "runner_origin",
        "preview_sha256"
      ],
      "title": "LabCollectionBinding",
      "type": "object"
    },
    "ObservationComparison": {
      "additionalProperties": false,
      "properties": {
        "alternative_explanations": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Alternative Explanations",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/EvidenceCitation"
          },
          "maxItems": 100,
          "title": "Citations",
          "type": "array"
        },
        "comparison_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Comparison Id",
          "type": "string"
        },
        "conclusion": {
          "enum": [
            "candidate",
            "rejected",
            "inconclusive"
          ],
          "title": "Conclusion",
          "type": "string"
        },
        "execution_status": {
          "const": "imported",
          "default": "imported",
          "title": "Execution Status",
          "type": "string"
        },
        "missing_evidence": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Missing Evidence",
          "type": "array"
        },
        "request": {
          "$ref": "#/$defs/ComparisonRequest"
        },
        "summary": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "comparison_id",
        "request",
        "conclusion",
        "summary"
      ],
      "title": "ObservationComparison",
      "type": "object"
    },
    "ObservationContext": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "request_context_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Request Context Id",
          "type": "string"
        },
        "session_context_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Session Context Id",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "object_id",
        "session_context_id",
        "request_context_id"
      ],
      "title": "ObservationContext",
      "type": "object"
    },
    "ScopeAuthority": {
      "additionalProperties": false,
      "properties": {
        "granted_at": {
          "format": "date-time",
          "title": "Granted At",
          "type": "string"
        },
        "granted_by": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Granted By",
          "type": "string"
        },
        "reference": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        }
      },
      "required": [
        "granted_by",
        "reference",
        "granted_at"
      ],
      "title": "ScopeAuthority",
      "type": "object"
    },
    "SyntheticObject": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "owner_account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Owner Account Id",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "synthetic_marker": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synthetic Marker"
        }
      },
      "required": [
        "object_id",
        "owner_account_id",
        "kind"
      ],
      "title": "SyntheticObject",
      "type": "object"
    },
    "TestAccount": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "label": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "role": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "role",
        "label"
      ],
      "title": "TestAccount",
      "type": "object"
    }
  },
  "$id": "https://plumb.local/schemas/AssessmentView.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analyses": {
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "maxItems": 100,
      "title": "Analyses",
      "type": "array"
    },
    "answers": {
      "items": {
        "$ref": "#/$defs/AssessmentAnswer"
      },
      "maxItems": 100,
      "title": "Answers",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/EvidenceArtifact"
      },
      "maxItems": 100,
      "title": "Artifacts",
      "type": "array"
    },
    "comparisons": {
      "items": {
        "$ref": "#/$defs/ObservationComparison"
      },
      "maxItems": 100,
      "title": "Comparisons",
      "type": "array"
    },
    "expectations": {
      "items": {
        "$ref": "#/$defs/AccessExpectation"
      },
      "maxItems": 100,
      "title": "Expectations",
      "type": "array"
    },
    "scope": {
      "$ref": "#/$defs/AssessmentScope"
    },
    "spent_requests": {
      "default": 0,
      "minimum": 0,
      "title": "Spent Requests",
      "type": "integer"
    },
    "spent_seconds": {
      "default": 0,
      "minimum": 0,
      "title": "Spent Seconds",
      "type": "number"
    },
    "stop_reason": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "stopped": {
      "default": false,
      "title": "Stopped",
      "type": "boolean"
    }
  },
  "required": [
    "scope"
  ],
  "title": "AssessmentView",
  "type": "object"
}
