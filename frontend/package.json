{
  "name": "plumb-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "contracts": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "tokens": "node scripts/tokens.mjs",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/next.mjs build --webpack"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "elkjs": "0.12.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
