{
  "$defs": {
    "AccessSite": {
      "additionalProperties": false,
      "description": "A place where a resource is loaded by a request-controlled identifier.",
      "properties": {
        "data_layer": {
          "$ref": "#/$defs/DataLayer"
        },
        "entry_point_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Entry Point Id",
          "type": "string"
        },
        "guard_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Guard Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "key_origin": {
          "$ref": "#/$defs/InputOrigin"
        },
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "id",
        "snapshot_id",
        "entry_point_id",
        "resource",
        "operation",
        "key_origin",
        "data_layer",
        "span"
      ],
      "title": "AccessSite",
      "type": "object"
    },
    "BoundPolicy": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "$ref": "#/$defs/PolicyAssertion"
        },
        "forbidden_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Forbidden Fields",
          "type": "array"
        },
        "provenance": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "required_role": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Role"
        },
        "sites": {
          "items": {
            "$ref": "#/$defs/AccessSite"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Sites",
          "type": "array"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Run Id",
          "type": "string"
        }
      },
      "required": [
        "assertion",
        "snapshot_id",
        "source_run_id",
        "sites",
        "provenance"
      ],
      "title": "BoundPolicy",
      "type": "object"
    },
    "ChallengeCheck": {
      "additionalProperties": false,
      "description": "One acquittal checklist item and what the search found (negative evidence).",
      "properties": {
        "exhibit_tag": {
          "anyOf": [
            {
              "pattern": "^E\\d{2,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exhibit Tag"
        },
        "found": {
          "title": "Found",
          "type": "boolean"
        },
        "item": {
          "title": "Item",
          "type": "string"
        },
        "searched": {
          "title": "Searched",
          "type": "string"
        }
      },
      "required": [
        "item",
        "searched",
        "found"
      ],
      "title": "ChallengeCheck",
      "type": "object"
    },
    "Conclusion": {
      "enum": [
        "candidate",
        "supported",
        "rejected",
        "inconclusive"
      ],
      "title": "Conclusion",
      "type": "string"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "setup_required",
        "model_too_large",
        "runner_unavailable",
        "stale_source",
        "unsupported_framework",
        "unreadable_file",
        "partial_coverage"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "True-denominator progress: every question is counted somewhere.",
      "properties": {
        "completed": {
          "default": 0,
          "minimum": 0,
          "title": "Completed",
          "type": "integer"
        },
        "excluded": {
          "default": 0,
          "minimum": 0,
          "title": "Excluded",
          "type": "integer"
        },
        "pending": {
          "default": 0,
          "minimum": 0,
          "title": "Pending",
          "type": "integer"
        },
        "total": {
          "default": 0,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "unsupported": {
          "default": 0,
          "minimum": 0,
          "title": "Unsupported",
          "type": "integer"
        }
      },
      "title": "Coverage",
      "type": "object"
    },
    "DataLayer": {
      "enum": [
        "sqlalchemy",
        "raw_sql",
        "prisma",
        "drizzle",
        "other"
      ],
      "title": "DataLayer",
      "type": "string"
    },
    "Disposition": {
      "enum": [
        "open",
        "dismissed",
        "accepted_risk",
        "resolved"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "EvidenceStrength": {
      "enum": [
        "complete",
        "partial",
        "thin"
      ],
      "title": "EvidenceStrength",
      "type": "string"
    },
    "Exhibit": {
      "additionalProperties": false,
      "properties": {
        "gloss": {
          "title": "Gloss",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ExhibitRole"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "tag": {
          "pattern": "^E\\d{2,3}$",
          "title": "Tag",
          "type": "string"
        }
      },
      "required": [
        "tag",
        "span",
        "role",
        "gloss"
      ],
      "title": "Exhibit",
      "type": "object"
    },
    "ExhibitRole": {
      "enum": [
        "evidence",
        "source",
        "sink",
        "guard",
        "deviant",
        "developer_note"
      ],
      "title": "ExhibitRole",
      "type": "string"
    },
    "Family": {
      "description": "Vulnerability families investigated in depth (PROJECT_PLAN \u00a74).",
      "enum": [
        "authorization",
        "injection",
        "path_traversal",
        "nextjs_exposure"
      ],
      "title": "Family",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "A case file. The five evidence-contract fields are independent (PROJECT_PLAN \u00a76).",
      "properties": {
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ChallengeCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "conclusion": {
          "$ref": "#/$defs/Conclusion"
        },
        "cwe": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Cwe",
          "type": "array"
        },
        "display_id": {
          "pattern": "^F-\\d{2,}$",
          "title": "Display Id",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/Disposition",
          "default": "open"
        },
        "disposition_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disposition Reason"
        },
        "exhibits": {
          "items": {
            "$ref": "#/$defs/Exhibit"
          },
          "title": "Exhibits",
          "type": "array"
        },
        "family": {
          "$ref": "#/$defs/Family"
        },
        "flow": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowStep"
          },
          "title": "Flow",
          "type": "array"
        },
        "gaps": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "lede": {
          "title": "Lede",
          "type": "string"
        },
        "peer_group_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peer Group Id"
        },
        "policy_basis": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BoundPolicy"
          },
          "maxItems": 100,
          "title": "Policy Basis",
          "type": "array"
        },
        "probe_run_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Probe Run Ids",
          "type": "array"
        },
        "question_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Question Ids",
          "type": "array"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "runtime_verification": {
          "$ref": "#/$defs/RuntimeVerification",
          "default": "not_attempted"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "severity_rationale": {
          "minLength": 1,
          "title": "Severity Rationale",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "strength": {
          "$ref": "#/$defs/EvidenceStrength"
        },
        "suggested_change_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Change Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "id",
        "display_id",
        "run_id",
        "snapshot_id",
        "family",
        "cwe",
        "title",
        "lede",
        "conclusion",
        "severity",
        "severity_rationale",
        "strength",
        "exhibits"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FlowStep": {
      "additionalProperties": false,
      "properties": {
        "exhibit_tag": {
          "pattern": "^E\\d{2,3}$",
          "title": "Exhibit Tag",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "exhibit_tag"
      ],
      "title": "FlowStep",
      "type": "object"
    },
    "GuardKind": {
      "description": "Canonical guard kinds from the ``guard_summary`` question (PROJECT_PLAN \u00a73.1).",
      "enum": [
        "authenticated",
        "owner",
        "tenant",
        "role",
        "none",
        "unknown",
        "parameterized",
        "allowlisted",
        "contained",
        "minimized"
      ],
      "title": "GuardKind",
      "type": "string"
    },
    "InputOrigin": {
      "description": "Where a value comes from, as answered by the ``input_origin`` question.",
      "enum": [
        "path",
        "query",
        "body",
        "header",
        "session",
        "constant",
        "unknown"
      ],
      "title": "InputOrigin",
      "type": "string"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "quantization": {
          "title": "Quantization",
          "type": "string"
        }
      },
      "required": [
        "id",
        "file_sha256",
        "quantization"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "Operation": {
      "enum": [
        "read",
        "list",
        "create",
        "update",
        "delete"
      ],
      "title": "Operation",
      "type": "string"
    },
    "PolicyAssertion": {
      "additionalProperties": false,
      "description": "An access rule, inferred from code or declared by a person.\n\nKept separate from code-derived facts, with author and provenance. A policy\nnever expands what the agent is allowed to do.",
      "properties": {
        "author": {
          "title": "Author",
          "type": "string"
        },
        "canonical": {
          "title": "Canonical",
          "type": "string"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed At"
        },
        "confirmed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed By"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GuardKind"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PolicyStatus"
        }
      },
      "required": [
        "id",
        "statement",
        "resource",
        "kind",
        "canonical",
        "status",
        "author",
        "created_at"
      ],
      "title": "PolicyAssertion",
      "type": "object"
    },
    "PolicyStatus": {
      "enum": [
        "inferred",
        "confirmed",
        "declared"
      ],
      "title": "PolicyStatus",
      "type": "string"
    },
    "ReviewRun": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Conditions",
          "type": "array"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage",
          "default": {
            "completed": 0,
            "excluded": 0,
            "pending": 0,
            "total": 0,
            "unsupported": 0
          }
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "finding_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/RunLifecycle"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_type": {
          "$ref": "#/$defs/RunType"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "toolchain": {
          "anyOf": [
            {
              "$ref": "#/$defs/Toolchain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "snapshot_id",
        "run_type",
        "lifecycle",
        "created_at"
      ],
      "title": "ReviewRun",
      "type": "object"
    },
    "RunLifecycle": {
      "enum": [
        "queued",
        "running",
        "paused",
        "canceled",
        "failed",
        "completed"
      ],
      "title": "RunLifecycle",
      "type": "string"
    },
    "RunStage": {
      "enum": [
        "indexing",
        "scanning",
        "investigating",
        "verifying",
        "reporting"
      ],
      "title": "RunStage",
      "type": "string"
    },
    "RunType": {
      "description": "Live, replayed, and saved runs are always labeled differently (PROJECT_PLAN \u00a715).",
      "enum": [
        "live",
        "replay",
        "saved"
      ],
      "title": "RunType",
      "type": "string"
    },
    "RuntimeVerification": {
      "enum": [
        "not_attempted",
        "unavailable",
        "inconclusive",
        "reproduced",
        "not_reproduced"
      ],
      "title": "RuntimeVerification",
      "type": "string"
    },
    "SecuritySignal": {
      "additionalProperties": false,
      "properties": {
        "advisory_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Advisory Id"
        },
        "category": {
          "enum": [
            "secret",
            "configuration",
            "dependency"
          ],
          "title": "Category",
          "type": "string"
        },
        "ecosystem": {
          "anyOf": [
            {
              "enum": [
                "npm",
                "PyPI"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ecosystem"
        },
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Limitations",
          "type": "array"
        },
        "package": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "maxLength": 100,
          "title": "Rule Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceSpan"
        },
        "status": {
          "enum": [
            "observed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 600,
          "title": "Summary",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "id",
        "category",
        "status",
        "source",
        "rule_id",
        "rule_version",
        "summary",
        "limitations"
      ],
      "title": "SecuritySignal",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SignalSet": {
      "additionalProperties": false,
      "properties": {
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Limitations",
          "type": "array"
        },
        "pack_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pack Date"
        },
        "pack_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pack Sha256"
        },
        "pack_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pack Source"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "signals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SecuritySignal"
          },
          "maxItems": 100,
          "title": "Signals",
          "type": "array"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "partial",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "snapshot_id",
        "tool_version",
        "status"
      ],
      "title": "SignalSet",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "A citation: lines in one file of one snapshot, with the hash of their text.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "path",
        "start_line",
        "end_line",
        "content_sha256"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "Toolchain": {
      "additionalProperties": false,
      "description": "Everything needed to reproduce a run (design.md \u00a712, Runs).",
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "knowledge_pack_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Pack Date"
        },
        "llama_cpp_build": {
          "title": "Llama Cpp Build",
          "type": "string"
        },
        "llama_cpp_release": {
          "title": "Llama Cpp Release",
          "type": "string"
        },
        "opengrep_rules_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opengrep Rules Sha256"
        },
        "opengrep_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opengrep Version"
        }
      },
      "required": [
        "llama_cpp_release",
        "llama_cpp_build",
        "backend"
      ],
      "title": "Toolchain",
      "type": "object"
    }
  },
  "$id": "https://plumb.local/schemas/FindingPage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 20,
      "title": "Findings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "next_offset": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Offset"
    },
    "offset": {
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "run": {
      "$ref": "#/$defs/ReviewRun"
    },
    "supplementary": {
      "anyOf": [
        {
          "$ref": "#/$defs/SignalSet"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "run",
    "findings",
    "limitations",
    "total",
    "offset"
  ],
  "title": "FindingPage",
  "type": "object"
}
