{
  "$defs": {
    "GuardKind": {
      "description": "Canonical guard kinds from the ``guard_summary`` question (PROJECT_PLAN \u00a73.1).",
      "enum": [
        "authenticated",
        "owner",
        "tenant",
        "role",
        "none",
        "unknown",
        "parameterized",
        "allowlisted",
        "contained",
        "minimized"
      ],
      "title": "GuardKind",
      "type": "string"
    },
    "GuardMechanism": {
      "enum": [
        "dependency",
        "decorator",
        "query_filter",
        "comparison",
        "helper_call",
        "data_access_layer",
        "router",
        "proxy_matcher"
      ],
      "title": "GuardMechanism",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "A citation: lines in one file of one snapshot, with the hash of their text.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "path",
        "start_line",
        "end_line",
        "content_sha256"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "$id": "https://plumb.local/schemas/Guard.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A check on the path to an access site, normalized to a canonical form.\n\n``confirmed`` means the validator found executable code at ``span`` that\nperforms the check. A name or a comment never confirms a guard.",
  "properties": {
    "canonical": {
      "title": "Canonical",
      "type": "string"
    },
    "confirmed": {
      "default": false,
      "title": "Confirmed",
      "type": "boolean"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/GuardKind"
    },
    "mechanism": {
      "$ref": "#/$defs/GuardMechanism"
    },
    "object": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object"
    },
    "role": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Role"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "span": {
      "$ref": "#/$defs/SourceSpan"
    },
    "subject": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject"
    },
    "via_symbol_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Via Symbol Id"
    }
  },
  "required": [
    "id",
    "snapshot_id",
    "kind",
    "canonical",
    "mechanism",
    "span"
  ],
  "title": "Guard",
  "type": "object"
}
