{
  "$id": "https://plumb.local/schemas/AccessExpectation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_account_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Allowed Account Ids",
      "type": "array"
    },
    "basis": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Basis",
      "type": "string"
    },
    "declared_by": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Declared By",
      "type": "string"
    },
    "expectation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Expectation Id",
      "type": "string"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "path": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "statement": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    }
  },
  "required": [
    "expectation_id",
    "path",
    "object_id",
    "allowed_account_ids",
    "statement",
    "declared_by",
    "basis"
  ],
  "title": "AccessExpectation",
  "type": "object"
}
