{
  "$id": "https://plumb.local/schemas/SourceSpan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A citation: lines in one file of one snapshot, with the hash of their text.",
  "properties": {
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "end_line": {
      "minimum": 1,
      "title": "End Line",
      "type": "integer"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "start_line": {
      "minimum": 1,
      "title": "Start Line",
      "type": "integer"
    }
  },
  "required": [
    "snapshot_id",
    "path",
    "start_line",
    "end_line",
    "content_sha256"
  ],
  "title": "SourceSpan",
  "type": "object"
}
