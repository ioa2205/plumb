{
  "$defs": {
    "DataLayer": {
      "enum": [
        "sqlalchemy",
        "raw_sql",
        "prisma",
        "drizzle",
        "other"
      ],
      "title": "DataLayer",
      "type": "string"
    },
    "InputOrigin": {
      "description": "Where a value comes from, as answered by the ``input_origin`` question.",
      "enum": [
        "path",
        "query",
        "body",
        "header",
        "session",
        "constant",
        "unknown"
      ],
      "title": "InputOrigin",
      "type": "string"
    },
    "Operation": {
      "enum": [
        "read",
        "list",
        "create",
        "update",
        "delete"
      ],
      "title": "Operation",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "A citation: lines in one file of one snapshot, with the hash of their text.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "path",
        "start_line",
        "end_line",
        "content_sha256"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "$id": "https://plumb.local/schemas/AccessSite.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A place where a resource is loaded by a request-controlled identifier.",
  "properties": {
    "data_layer": {
      "$ref": "#/$defs/DataLayer"
    },
    "entry_point_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Entry Point Id",
      "type": "string"
    },
    "guard_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "title": "Guard Ids",
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "key_origin": {
      "$ref": "#/$defs/InputOrigin"
    },
    "operation": {
      "$ref": "#/$defs/Operation"
    },
    "resource": {
      "title": "Resource",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "span": {
      "$ref": "#/$defs/SourceSpan"
    }
  },
  "required": [
    "id",
    "snapshot_id",
    "entry_point_id",
    "resource",
    "operation",
    "key_origin",
    "data_layer",
    "span"
  ],
  "title": "AccessSite",
  "type": "object"
}
