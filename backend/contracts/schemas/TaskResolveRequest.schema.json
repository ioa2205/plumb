{
  "$defs": {
    "AssessmentBudget": {
      "additionalProperties": false,
      "properties": {
        "max_requests": {
          "default": 3,
          "maximum": 30,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_seconds": {
          "default": 180,
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Seconds",
          "type": "integer"
        }
      },
      "title": "AssessmentBudget",
      "type": "object"
    }
  },
  "$id": "https://plumb.local/schemas/TaskResolveRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budget": {
      "$ref": "#/$defs/AssessmentBudget"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 3,
      "title": "Evidence Ids",
      "type": "array"
    },
    "prompt": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    }
  },
  "required": [
    "prompt"
  ],
  "title": "TaskResolveRequest",
  "type": "object"
}
