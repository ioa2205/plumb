{
  "$id": "https://plumb.local/schemas/ChatSelect.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit selection of what follow-ups are about; made by a control, not by a message.",
  "properties": {
    "target_id": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Id"
    },
    "target_kind": {
      "anyOf": [
        {
          "enum": [
            "inspection",
            "review",
            "assessment",
            "website"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Kind"
    }
  },
  "title": "ChatSelect",
  "type": "object"
}
