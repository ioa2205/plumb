{
  "$defs": {
    "ComparisonRow": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindingRow"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindingRow"
            },
            {
              "type": "null"
            }
          ]
        },
        "group": {
          "enum": [
            "new",
            "still_present",
            "no_longer_observed",
            "not_reviewed"
          ],
          "title": "Group",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "group",
        "before",
        "after",
        "reason"
      ],
      "title": "ComparisonRow",
      "type": "object"
    },
    "Conclusion": {
      "enum": [
        "candidate",
        "supported",
        "rejected",
        "inconclusive"
      ],
      "title": "Conclusion",
      "type": "string"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "setup_required",
        "model_too_large",
        "runner_unavailable",
        "stale_source",
        "unsupported_framework",
        "unreadable_file",
        "partial_coverage"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "True-denominator progress: every question is counted somewhere.",
      "properties": {
        "completed": {
          "default": 0,
          "minimum": 0,
          "title": "Completed",
          "type": "integer"
        },
        "excluded": {
          "default": 0,
          "minimum": 0,
          "title": "Excluded",
          "type": "integer"
        },
        "pending": {
          "default": 0,
          "minimum": 0,
          "title": "Pending",
          "type": "integer"
        },
        "total": {
          "default": 0,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "unsupported": {
          "default": 0,
          "minimum": 0,
          "title": "Unsupported",
          "type": "integer"
        }
      },
      "title": "Coverage",
      "type": "object"
    },
    "Disposition": {
      "enum": [
        "open",
        "dismissed",
        "accepted_risk",
        "resolved"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "Family": {
      "description": "Vulnerability families investigated in depth (PROJECT_PLAN \u00a74).",
      "enum": [
        "authorization",
        "injection",
        "path_traversal",
        "nextjs_exposure"
      ],
      "title": "Family",
      "type": "string"
    },
    "FindingRow": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "$ref": "#/$defs/Conclusion"
        },
        "display_id": {
          "title": "Display Id",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "family": {
          "$ref": "#/$defs/Family"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_verification": {
          "$ref": "#/$defs/RuntimeVerification"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display_id",
        "title",
        "family",
        "conclusion",
        "severity",
        "runtime_verification",
        "disposition",
        "location"
      ],
      "title": "FindingRow",
      "type": "object"
    },
    "GuardCount": {
      "additionalProperties": false,
      "properties": {
        "applying": {
          "minimum": 0,
          "title": "Applying",
          "type": "integer"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/ProjectCitation"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "total": {
          "minimum": 1,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "applying",
        "total",
        "citations"
      ],
      "title": "GuardCount",
      "type": "object"
    },
    "GuardKind": {
      "description": "Canonical guard kinds from the ``guard_summary`` question (PROJECT_PLAN \u00a73.1).",
      "enum": [
        "authenticated",
        "owner",
        "tenant",
        "role",
        "none",
        "unknown",
        "parameterized",
        "allowlisted",
        "contained",
        "minimized"
      ],
      "title": "GuardKind",
      "type": "string"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "quantization": {
          "title": "Quantization",
          "type": "string"
        }
      },
      "required": [
        "id",
        "file_sha256",
        "quantization"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "PolicyDrift": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/GuardCount"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/GuardCount"
            },
            {
              "type": "null"
            }
          ]
        },
        "cohort_changed": {
          "title": "Cohort Changed",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/GuardKind"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        }
      },
      "required": [
        "resource",
        "kind",
        "before",
        "after",
        "cohort_changed",
        "reason"
      ],
      "title": "PolicyDrift",
      "type": "object"
    },
    "ProjectCitation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "id",
        "span"
      ],
      "title": "ProjectCitation",
      "type": "object"
    },
    "ReviewRun": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Conditions",
          "type": "array"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage",
          "default": {
            "completed": 0,
            "excluded": 0,
            "pending": 0,
            "total": 0,
            "unsupported": 0
          }
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "finding_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/RunLifecycle"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_type": {
          "$ref": "#/$defs/RunType"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "toolchain": {
          "anyOf": [
            {
              "$ref": "#/$defs/Toolchain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "snapshot_id",
        "run_type",
        "lifecycle",
        "created_at"
      ],
      "title": "ReviewRun",
      "type": "object"
    },
    "RunLifecycle": {
      "enum": [
        "queued",
        "running",
        "paused",
        "canceled",
        "failed",
        "completed"
      ],
      "title": "RunLifecycle",
      "type": "string"
    },
    "RunStage": {
      "enum": [
        "indexing",
        "scanning",
        "investigating",
        "verifying",
        "reporting"
      ],
      "title": "RunStage",
      "type": "string"
    },
    "RunType": {
      "description": "Live, replayed, and saved runs are always labeled differently (PROJECT_PLAN \u00a715).",
      "enum": [
        "live",
        "replay",
        "saved"
      ],
      "title": "RunType",
      "type": "string"
    },
    "RuntimeVerification": {
      "enum": [
        "not_attempted",
        "unavailable",
        "inconclusive",
        "reproduced",
        "not_reproduced"
      ],
      "title": "RuntimeVerification",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "A citation: lines in one file of one snapshot, with the hash of their text.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "path",
        "start_line",
        "end_line",
        "content_sha256"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "Toolchain": {
      "additionalProperties": false,
      "description": "Everything needed to reproduce a run (design.md \u00a712, Runs).",
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "knowledge_pack_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Pack Date"
        },
        "llama_cpp_build": {
          "title": "Llama Cpp Build",
          "type": "string"
        },
        "llama_cpp_release": {
          "title": "Llama Cpp Release",
          "type": "string"
        },
        "opengrep_rules_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opengrep Rules Sha256"
        },
        "opengrep_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opengrep Version"
        }
      },
      "required": [
        "llama_cpp_release",
        "llama_cpp_build",
        "backend"
      ],
      "title": "Toolchain",
      "type": "object"
    }
  },
  "$id": "https://plumb.local/schemas/RunComparison.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after": {
      "$ref": "#/$defs/ReviewRun"
    },
    "before": {
      "$ref": "#/$defs/ReviewRun"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "new",
          "still_present",
          "no_longer_observed",
          "not_reviewed"
        ]
      },
      "title": "Counts",
      "type": "object"
    },
    "group": {
      "enum": [
        "new",
        "still_present",
        "no_longer_observed",
        "not_reviewed"
      ],
      "title": "Group",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Offset"
    },
    "offset": {
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "policies": {
      "items": {
        "$ref": "#/$defs/PolicyDrift"
      },
      "maxItems": 20,
      "title": "Policies",
      "type": "array"
    },
    "policies_total": {
      "minimum": 0,
      "title": "Policies Total",
      "type": "integer"
    },
    "policy_next_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Policy Next Offset"
    },
    "policy_offset": {
      "minimum": 0,
      "title": "Policy Offset",
      "type": "integer"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/ComparisonRow"
      },
      "maxItems": 20,
      "title": "Rows",
      "type": "array"
    }
  },
  "required": [
    "before",
    "after",
    "group",
    "rows",
    "counts",
    "offset",
    "next_offset",
    "policies",
    "policies_total",
    "policy_offset",
    "policy_next_offset",
    "limitations"
  ],
  "title": "RunComparison",
  "type": "object"
}
