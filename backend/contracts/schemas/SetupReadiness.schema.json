{
  "$defs": {
    "CapabilityEvidence": {
      "additionalProperties": false,
      "properties": {
        "current_engine_acceptance": {
          "const": false,
          "default": false,
          "title": "Current Engine Acceptance",
          "type": "boolean"
        },
        "record": {
          "title": "Record",
          "type": "string"
        },
        "scope": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "record",
        "sha256",
        "scope"
      ],
      "title": "CapabilityEvidence",
      "type": "object"
    },
    "CapabilityRow": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "language",
            "framework",
            "family"
          ],
          "title": "Category",
          "type": "string"
        },
        "indexed": {
          "enum": [
            "observed",
            "partial",
            "unverified",
            "not_applicable"
          ],
          "title": "Indexed",
          "type": "string"
        },
        "indexed_units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indexed Units"
        },
        "investigated": {
          "const": false,
          "default": false,
          "title": "Investigated",
          "type": "boolean"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parsed": {
          "enum": [
            "observed",
            "partial",
            "unverified",
            "not_applicable"
          ],
          "title": "Parsed",
          "type": "string"
        },
        "parsed_units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parsed Units"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "runtime_testable": {
          "const": false,
          "default": false,
          "title": "Runtime Testable",
          "type": "boolean"
        },
        "units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "workflow_implemented": {
          "title": "Workflow Implemented",
          "type": "boolean"
        }
      },
      "required": [
        "category",
        "name",
        "parsed",
        "indexed",
        "workflow_implemented",
        "reason"
      ],
      "title": "CapabilityRow",
      "type": "object"
    },
    "CapabilityTable": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/CapabilityEvidence"
          },
          "maxItems": 10,
          "title": "Evidence",
          "type": "array"
        },
        "quality_note": {
          "title": "Quality Note",
          "type": "string"
        },
        "registry_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Registry Sha256",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/CapabilityRow"
          },
          "maxItems": 10,
          "title": "Rows",
          "type": "array"
        },
        "runtime_note": {
          "title": "Runtime Note",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        }
      },
      "required": [
        "registry_sha256",
        "rows",
        "evidence",
        "runtime_note",
        "quality_note"
      ],
      "title": "CapabilityTable",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "setup_required",
        "model_too_large",
        "runner_unavailable",
        "stale_source",
        "unsupported_framework",
        "unreadable_file",
        "partial_coverage"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "ModelCatalog": {
      "additionalProperties": false,
      "properties": {
        "available_ram_bytes": {
          "minimum": 0,
          "title": "Available Ram Bytes",
          "type": "integer"
        },
        "available_vram_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available Vram Bytes"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "downloads_started": {
          "const": false,
          "default": false,
          "title": "Downloads Started",
          "type": "boolean"
        },
        "model_loaded": {
          "const": false,
          "default": false,
          "title": "Model Loaded",
          "type": "boolean"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelChoice"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Models",
          "type": "array"
        },
        "recommended_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recommended Profile"
        },
        "selected_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Profile"
        },
        "selection_basis": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Selection Basis",
          "type": "string"
        }
      },
      "required": [
        "checked_at",
        "selected_profile",
        "recommended_profile",
        "selection_basis",
        "available_ram_bytes",
        "available_vram_bytes",
        "models"
      ],
      "title": "ModelCatalog",
      "type": "object"
    },
    "ModelChoice": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "model_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/ModelProfileChoice"
          },
          "maxItems": 8,
          "title": "Profiles",
          "type": "array"
        },
        "quantization": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Quantization",
          "type": "string"
        },
        "requires_download_approval": {
          "title": "Requires Download Approval",
          "type": "boolean"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "verified_installed": {
          "title": "Verified Installed",
          "type": "boolean"
        }
      },
      "required": [
        "model_id",
        "family",
        "quantization",
        "size_bytes",
        "verified_installed",
        "requires_download_approval",
        "profiles"
      ],
      "title": "ModelChoice",
      "type": "object"
    },
    "ModelProfileChoice": {
      "additionalProperties": false,
      "properties": {
        "automatic_eligible": {
          "title": "Automatic Eligible",
          "type": "boolean"
        },
        "available_vram_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available Vram Bytes"
        },
        "backend": {
          "enum": [
            "cpu",
            "vulkan"
          ],
          "title": "Backend",
          "type": "string"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Conditions",
          "type": "array"
        },
        "first_use_check": {
          "enum": [
            "not needed",
            "pending",
            "passed",
            "failed"
          ],
          "title": "First Use Check",
          "type": "string"
        },
        "hardware_compatible": {
          "title": "Hardware Compatible",
          "type": "boolean"
        },
        "launch_available": {
          "title": "Launch Available",
          "type": "boolean"
        },
        "memory_fit": {
          "title": "Memory Fit",
          "type": "boolean"
        },
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "quality_note": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Quality Note",
          "type": "string"
        },
        "quality_records": {
          "items": {
            "$ref": "#/$defs/ModelQualityRecord"
          },
          "maxItems": 4,
          "title": "Quality Records",
          "type": "array"
        },
        "quality_state": {
          "enum": [
            "recorded_scoped",
            "untested"
          ],
          "title": "Quality State",
          "type": "string"
        },
        "required_ram_bytes": {
          "minimum": 1,
          "title": "Required Ram Bytes",
          "type": "integer"
        },
        "required_vram_bytes": {
          "minimum": 0,
          "title": "Required Vram Bytes",
          "type": "integer"
        },
        "runtime_compatible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Runtime Compatible"
        },
        "runtime_verified": {
          "title": "Runtime Verified",
          "type": "boolean"
        }
      },
      "required": [
        "profile_id",
        "backend",
        "hardware_compatible",
        "memory_fit",
        "required_ram_bytes",
        "required_vram_bytes",
        "available_vram_bytes",
        "runtime_verified",
        "runtime_compatible",
        "first_use_check",
        "launch_available",
        "automatic_eligible",
        "quality_state",
        "quality_records",
        "quality_note",
        "conditions"
      ],
      "title": "ModelProfileChoice",
      "type": "object"
    },
    "ModelQualityRecord": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^docs/results/[a-zA-Z0-9._/-]+\\.json$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ModelQualityRecord",
      "type": "object"
    }
  },
  "$id": "https://plumb.local/schemas/SetupReadiness.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "available_ram_bytes": {
      "minimum": 0,
      "title": "Available Ram Bytes",
      "type": "integer"
    },
    "available_vram_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Available Vram Bytes"
    },
    "capabilities": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapabilityTable"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "conditions": {
      "items": {
        "$ref": "#/$defs/Condition"
      },
      "title": "Conditions",
      "type": "array"
    },
    "downloads_started": {
      "const": false,
      "default": false,
      "title": "Downloads Started",
      "type": "boolean"
    },
    "inspect_ready": {
      "title": "Inspect Ready",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "measured_host": {
      "title": "Measured Host",
      "type": "boolean"
    },
    "memory_fit": {
      "title": "Memory Fit",
      "type": "boolean"
    },
    "missing_download_bytes": {
      "minimum": 0,
      "title": "Missing Download Bytes",
      "type": "integer"
    },
    "model_catalog": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelCatalog"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "model_loaded": {
      "const": false,
      "default": false,
      "title": "Model Loaded",
      "type": "boolean"
    },
    "model_size_bytes": {
      "minimum": 1,
      "title": "Model Size Bytes",
      "type": "integer"
    },
    "model_verified": {
      "title": "Model Verified",
      "type": "boolean"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "ready": {
      "title": "Ready",
      "type": "boolean"
    },
    "required_ram_bytes": {
      "minimum": 1,
      "title": "Required Ram Bytes",
      "type": "integer"
    },
    "required_vram_bytes": {
      "minimum": 0,
      "title": "Required Vram Bytes",
      "type": "integer"
    },
    "requires_large_download_approval": {
      "title": "Requires Large Download Approval",
      "type": "boolean"
    },
    "runtime_verified": {
      "title": "Runtime Verified",
      "type": "boolean"
    }
  },
  "required": [
    "checked_at",
    "ready",
    "inspect_ready",
    "profile_id",
    "model_id",
    "model_size_bytes",
    "model_verified",
    "runtime_verified",
    "measured_host",
    "memory_fit",
    "available_ram_bytes",
    "required_ram_bytes",
    "available_vram_bytes",
    "required_vram_bytes",
    "missing_download_bytes",
    "requires_large_download_approval",
    "conditions",
    "limitations"
  ],
  "title": "SetupReadiness",
  "type": "object"
}
