{
  "$defs": {
    "EntryPointKind": {
      "enum": [
        "http_route",
        "route_handler",
        "server_action",
        "page"
      ],
      "title": "EntryPointKind",
      "type": "string"
    },
    "Framework": {
      "enum": [
        "fastapi",
        "nextjs"
      ],
      "title": "Framework",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "A citation: lines in one file of one snapshot, with the hash of their text.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "path",
        "start_line",
        "end_line",
        "content_sha256"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "$id": "https://plumb.local/schemas/EntryPoint.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "framework": {
      "$ref": "#/$defs/Framework"
    },
    "handler_symbol_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Handler Symbol Id",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/EntryPointKind"
    },
    "method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method"
    },
    "route": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Route"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "span": {
      "$ref": "#/$defs/SourceSpan"
    }
  },
  "required": [
    "id",
    "snapshot_id",
    "kind",
    "framework",
    "handler_symbol_id",
    "span"
  ],
  "title": "EntryPoint",
  "type": "object"
}
