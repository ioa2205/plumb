              }
            },
            {
              "level": "note",
              "message": {
                "text": "Valid citations establish grounding, not the correctness of a security judgment."
              }
            },
            {
              "level": "note",
              "message": {
                "text": "Exports omit source text. Redaction covers known credential shapes and supplied secret values, not arbitrary secrets."
              }
            },
            {
              "level": "note",
              "message": {
                "text": "Only selected families and recognized source forms are investigated. Unsupported flows remain explicit gaps."
              }
            },
            {
              "level": "note",
              "message": {
                "text": "Python resolution uses the static import fallback. Dynamic dispatch and unsupported guards remain gaps."
              }
            },
            {
              "level": "note",
              "message": {
                "text": "No target code was executed. Runtime verification is unavailable; source-based severity does not establish runtime impact."
              }
            },
            {
              "level": "note",
              "message": {
                "text": "Coverage counts discovered access sites, not every possible vulnerability or source file."
              }
            },
            {
              "level": "note",
              "message": {
                "text": "Peer analysis covers the selected resources; excluded resources cannot establish their policies."
              }
            },
            {
              "level": "note",
              "message": {
                "text": "Queue peer checks reuse validated exact-source/profile summaries only; uncached guards stay unknown until investigation."
              }
