{
  "$defs": {
    "AccessSite": {
      "additionalProperties": false,
      "description": "A place where a resource is loaded by a request-controlled identifier.",
      "properties": {
        "data_layer": {
          "$ref": "#/$defs/DataLayer"
        },
        "entry_point_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Entry Point Id",
          "type": "string"
        },
        "guard_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Guard Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "key_origin": {
          "$ref": "#/$defs/InputOrigin"
        },
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "id",
        "snapshot_id",
        "entry_point_id",
        "resource",
        "operation",
        "key_origin",
        "data_layer",
        "span"
      ],
      "title": "AccessSite",
      "type": "object"
    },
    "BoundPolicy": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "$ref": "#/$defs/PolicyAssertion"
        },
        "forbidden_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Forbidden Fields",
          "type": "array"
        },
        "provenance": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "required_role": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Role"
        },
        "sites": {
          "items": {
            "$ref": "#/$defs/AccessSite"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Sites",
          "type": "array"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Run Id",
          "type": "string"
        }
      },
      "required": [
        "assertion",
        "snapshot_id",
        "source_run_id",
        "sites",
        "provenance"
      ],
      "title": "BoundPolicy",
      "type": "object"
    },
    "CaseInput": {
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "title": "Cluster",
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/Family"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "id": {
          "pattern": "^TANDIR-[A-Z0-9-]+$",
          "title": "Id",
          "type": "string"
        },
        "input_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Id",
          "type": "string"
        },
        "label": {
          "enum": [
            "vulnerable",
            "safe"
          ],
          "title": "Label",
          "type": "string"
        },
        "pair_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pair Id"
        },
        "source": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "id",
        "input_id",
        "family",
        "label",
        "source",
        "file_sha256",
        "cluster"
      ],
      "title": "CaseInput",
      "type": "object"
    },
    "DataLayer": {
      "enum": [
        "sqlalchemy",
        "raw_sql",
        "prisma",
        "drizzle",
        "other"
      ],
      "title": "DataLayer",
      "type": "string"
    },
    "ExcludedFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/ExclusionReason"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "ExcludedFile",
      "type": "object"
    },
    "ExclusionReason": {
      "enum": [
        "too_large",
        "binary",
        "link",
        "unsupported",
        "secret",
        "user_excluded",
        "unreadable",
        "sealed",
        "default_ignored"
      ],
      "title": "ExclusionReason",
      "type": "string"
    },
    "Family": {
      "description": "Vulnerability families investigated in depth (PROJECT_PLAN \u00a74).",
      "enum": [
        "authorization",
        "injection",
        "path_traversal",
        "nextjs_exposure"
      ],
      "title": "Family",
      "type": "string"
    },
    "FrozenPolicies": {
      "additionalProperties": false,
      "properties": {
        "policies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BoundPolicy"
          },
          "maxItems": 100,
          "title": "Policies",
          "type": "array"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "FrozenPolicies",
      "type": "object"
    },
    "GuardKind": {
      "description": "Canonical guard kinds from the ``guard_summary`` question (PROJECT_PLAN \u00a73.1).",
      "enum": [
        "authenticated",
        "owner",
        "tenant",
        "role",
        "none",
        "unknown",
        "parameterized",
        "allowlisted",
        "contained",
        "minimized"
      ],
      "title": "GuardKind",
      "type": "string"
    },
    "InputOrigin": {
      "description": "Where a value comes from, as answered by the ``input_origin`` question.",
      "enum": [
        "path",
        "query",
        "body",
        "header",
        "session",
        "constant",
        "unknown"
      ],
      "title": "InputOrigin",
      "type": "string"
    },
    "JsonValue": {},
    "Language": {
      "enum": [
        "python",
        "typescript",
        "tsx",
        "javascript"
      ],
      "title": "Language",
      "type": "string"
    },
    "Operation": {
      "enum": [
        "read",
        "list",
        "create",
        "update",
        "delete"
      ],
      "title": "Operation",
      "type": "string"
    },
    "PolicyAssertion": {
      "additionalProperties": false,
      "description": "An access rule, inferred from code or declared by a person.\n\nKept separate from code-derived facts, with author and provenance. A policy\nnever expands what the agent is allowed to do.",
      "properties": {
        "author": {
          "title": "Author",
          "type": "string"
        },
        "canonical": {
          "title": "Canonical",
          "type": "string"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed At"
        },
        "confirmed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed By"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GuardKind"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PolicyStatus"
        }
      },
      "required": [
        "id",
        "statement",
        "resource",
        "kind",
        "canonical",
        "status",
        "author",
        "created_at"
      ],
      "title": "PolicyAssertion",
      "type": "object"
    },
    "PolicyStatus": {
      "enum": [
        "inferred",
        "confirmed",
        "declared"
      ],
      "title": "PolicyStatus",
      "type": "string"
    },
    "ProjectSnapshot": {
      "additionalProperties": false,
      "description": "The exact files a review looked at, including uncommitted changes.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dirty"
        },
        "excluded": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExcludedFile"
          },
          "title": "Excluded",
          "type": "array"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/SnapshotFile"
          },
          "title": "Files",
          "type": "array"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Id",
          "type": "string"
        },
        "root_name": {
          "title": "Root Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "root_name",
        "created_at",
        "files"
      ],
      "title": "ProjectSnapshot",
      "type": "object"
    },
    "SnapshotFile": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/Language"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "SnapshotFile",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "A citation: lines in one file of one snapshot, with the hash of their text.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "path",
        "start_line",
        "end_line",
        "content_sha256"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseInput"
      },
      "maxItems": 100,
      "minItems": 2,
      "title": "Cases",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "final_candidate": {
      "const": false,
      "default": false,
      "title": "Final Candidate",
      "type": "boolean"
    },
    "ground_truth_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ground Truth Sha256",
      "type": "string"
    },
    "harness": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Harness",
      "type": "object"
    },
    "hypothesis": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Hypothesis",
      "type": "string"
    },
    "implementation": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Implementation",
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "max_requests": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "title": "Max Requests",
      "type": "integer"
    },
    "max_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 14400,
      "title": "Max Seconds",
      "type": "integer"
    },
    "methods": {
      "default": [
        "full_plumb",
        "opengrep",
        "one_shot",
        "no_peer",
        "no_challenge",
        "no_grammar",
        "no_self_consistency",
        "no_verification"
      ],
      "items": {
        "enum": [
          "full_plumb",
          "opengrep",
          "one_shot",
          "no_peer",
          "no_challenge",
          "no_grammar",
          "no_self_consistency",
          "no_verification"
        ],
        "type": "string"
      },
      "title": "Methods",
      "type": "array"
    },
    "model": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Model",
      "type": "object"
    },
    "preparation_machine": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Preparation Machine",
      "type": "object"
    },
    "production_judgments": {
      "const": 3,
      "default": 3,
      "title": "Production Judgments",
      "type": "integer"
    },
    "profile": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Profile",
      "type": "object"
    },
    "requirements": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrozenPolicies"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "requirements_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requirements Sha256"
    },
    "runtime": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Runtime",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "const": "tandir_development_preparation",
      "default": "tandir_development_preparation",
      "title": "Scope",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/ProjectSnapshot"
    },
    "split_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Split Manifest Sha256",
      "type": "string"
    },
    "stop_rule": {
      "const": "stop_at_budget_or_first_process_memory_failure",
      "default": "stop_at_budget_or_first_process_memory_failure",
      "title": "Stop Rule",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "hypothesis",
    "max_requests",
    "max_seconds",
    "snapshot",
    "cases",
    "implementation",
    "harness",
    "model",
    "runtime",
    "profile",
    "ground_truth_sha256",
    "split_manifest_sha256",
    "preparation_machine"
  ],
  "title": "Preparation",
  "type": "object"
}
