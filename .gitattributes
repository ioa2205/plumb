# Store and check out text as LF on every machine. Git for Windows ships with
# core.autocrlf=true, which would rewrite files on checkout and change the
# content hashes that snapshots and the hash-pinned Tandir manifest rely on.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.pdf binary
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.gguf binary

# Preserve the exact captured bytes bound by this development result inventory.
docs/results/2026-10-11-fa-local-model/*.log -text
# These exact Windows captures intentionally retain CRLF in their hashed bytes.
docs/results/2026-10-11-tool-assisted/raw/*.log -text whitespace=cr-at-eol
